{
  "name": "turf-matrix",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "dev:race-batch": "npm run generate:race-batch && vite --mode batch",
    "build": "npm run verify:data-integrity && vite build",
    "build:race-batch": "npm run generate:race-batch && vite build --mode batch",
    "preview": "vite preview",
    "detect:jvlink": "powershell -ExecutionPolicy Bypass -File tools/jvlink/jvlink-cli.ps1 -Action detect",
    "probe:jvlink": "powershell -ExecutionPolicy Bypass -File tools/jvlink/jvlink-cli.ps1 -Action probe",
    "inspect:jvlink-week": "powershell -ExecutionPolicy Bypass -File tools/jvlink/jvlink-cli.ps1 -Action inspect-week",
    "export:jvlink-week": "powershell -ExecutionPolicy Bypass -File tools/jvlink/jvlink-cli.ps1 -Action export-week",
    "build:opponent-evidence": "node tools/jvlink/build-opponent-evidence.mjs",
    "detect:html": "node tools/target-html/detect-html-inputs.mjs",
    "inspect:rc1b": "node tools/rc1b-inspect-inputs.mjs",
    "inspect:race-batch": "node tools/inspect-race-batch.mjs",
    "scaffold:race-batch": "node tools/scaffold-race-batch-inputs.mjs",
    "pad:manifest": "node tools/generate-pad-race-batch-manifest.mjs",
    "normalize:rc1b": "node tools/normalizers/normalized-horse.mjs",
    "normalize:race-batch": "node tools/normalizers/race-batch.mjs",
    "generate:race-batch": "npm run normalize:race-batch && node tools/generate-race-batch-candidate.mjs",
    "generate:all-race-signals": "node tools/generate-all-race-signals.mjs",
    "thursday:preview": "npm run build:race-batch",
    "prepare:race-release": "node tools/prepare-race-batch-release.mjs",
    "saturday:publish": "powershell -ExecutionPolicy Bypass -File tools/publish-race-batch.ps1",
    "generate:candidate": "npm run generate:race-batch",
    "test:intelligence": "node --test tools/intelligence/tests/*.test.mjs",
    "verify:intelligence": "npm run generate:race-batch && npm run test:intelligence",
    "learn:blood": "node tools/learn/extract-blood-aptitude.mjs",
    "learn:blood:week": "npm run learn:blood && node tools/learn/build-week-blood-candidates.mjs",
    "review:blood:graded": "node tools/learn/review-registration-blood.mjs",
    "approve:blood": "node tools/learn/promote-blood-aptitude.mjs --confirm",
    "learn:stables": "node tools/learn/extract-stable-patterns.mjs",
    "import:stables:history": "node tools/learn/import-jv-stable-history.mjs",
    "approve:stables": "node tools/learn/promote-stable-patterns.mjs --confirm",
    "verify:data-integrity": "node tools/verify-data-integrity.mjs",
    "verify:odds": "node tools/verify-odds.mjs",
    "verify:going": "node tools/verify-going-adjustment.mjs",
    "analyze:engines": "node tools/analyze/engine-stats.mjs",
    "analyze:whatif": "node tools/analyze/normalize-what-if.mjs",
    "analyze:whatif:selective": "node tools/analyze/normalize-what-if-selective.mjs",
    "analyze:weight": "node tools/analyze/weight-effect-whatif.mjs",
    "analyze:opponents": "node tools/analyze/opponent-selection-whatif.mjs",
    "analyze:index-leader": "node tools/analyze/index-leader-whatif.mjs",
    "analyze:index-leader:holdout": "node tools/analyze/index-leader-holdout.mjs",
    "shadow:index-leader:freeze": "node tools/analyze/freeze-index-leader-shadow.mjs",
    "shadow:index-leader:evaluate": "node tools/analyze/evaluate-index-leader-shadow.mjs",
    "analyze:race-level": "node tools/analyze/opponent-race-level-whatif.mjs",
    "analyze:blood:renormalize": "node tools/analyze/blood-renormalize.mjs",
    "analyze:blood:center-trait": "node tools/analyze/blood-center-trait.mjs",
    "analyze:blood:center-compat-leaf": "node tools/analyze/blood-center-compat-leaf.mjs",
    "analyze:blood:vector": "node tools/analyze/blood-vector-alignment.mjs",
    "analyze:blood:lineage-vector": "node tools/analyze/blood-lineage-vector.mjs",
    "archive:preodds": "node tools/archive-race-release.mjs",
    "archive:odds": "node tools/archive-odds-snapshot.mjs",
    "auto:odds:check": "node tools/auto-odds-update.mjs --dry-run",
    "auto:odds:watch": "node tools/auto-odds-update.mjs --watch --lead-minutes=7 --poll-seconds=60",
    "auto:odds:register": "powershell -ExecutionPolicy Bypass -File tools/jvfetch/register-auto-odds-task.ps1",
    "auto:odds:install-isolated": "powershell -ExecutionPolicy Bypass -File tools/jvfetch/install-isolated-odds-runner.ps1",
    "generate:preodds": "node tools/generate-preodds.mjs",
    "validate:csv": "node tools/validate-csv-inputs.mjs",
    "generate-week": "node tools/generate-week-safe.mjs",
    "weekly:update": "powershell -ExecutionPolicy Bypass -File tools/weekly-update.ps1",
    "update-data": "node tools/update-data.mjs tools/week-data.json src/App.jsx",
    "jvfetch:check": "powershell -ExecutionPolicy Bypass -File tools/jvfetch/run-jvfetch.ps1 --check",
    "jvfetch:week": "powershell -ExecutionPolicy Bypass -File tools/jvfetch/run-week.ps1",
    "jvfetch:saturday": "powershell -ExecutionPolicy Bypass -File tools/jvfetch/run-weekend-specials.ps1 -Day Saturday",
    "jvfetch:sunday": "powershell -ExecutionPolicy Bypass -File tools/jvfetch/run-weekend-specials.ps1 -Day Sunday",
    "jvfetch:odds": "powershell -ExecutionPolicy Bypass -File tools/jvfetch/capture-odds.ps1",
    "jvfetch:conditions": "powershell -ExecutionPolicy Bypass -File tools/jvfetch/run-jvfetch.ps1 --conditions-only && node tools/jvlink/extract-race-conditions.mjs",
    "jvfetch:results": "powershell -ExecutionPolicy Bypass -File tools/jvfetch/run-jvfetch.ps1 --results-only",
    "archive:results": "powershell -ExecutionPolicy Bypass -File tools/jvfetch/run-jvfetch.ps1 --results-only && node tools/archive-jv-results.mjs",
    "jvfetch:live": "npm run jvfetch:odds && npm run jvfetch:conditions",
    "jvfetch:adopt-odds": "powershell -ExecutionPolicy Bypass -File tools/adopt-jvfetch-odds.ps1",
    "jvfetch:distribute-odds": "node tools/jvfetch/distribute-odds.mjs",
    "verify:jvfetch-odds": "node tools/verify-jvfetch-odds.mjs",
    "verify:jvfetch-conditions": "node tools/verify-jvfetch-conditions.mjs",
    "verify:jvfetch-week": "node tools/verify-jvfetch-week.mjs",
    "verify:jvfetch-normalizer": "node tools/verify-jvfetch-normalizer.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  }
}
